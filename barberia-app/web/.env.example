# --- públicas (se incluyen en el bundle del navegador) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://tudominio.com
NEXT_PUBLIC_GOOGLE_MAPS_KEY=       # restringida por dominio (HTTP referrer)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- SECRETAS: nunca con prefijo NEXT_PUBLIC_ ---
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
CRON_SECRET=                      # secreto largo y aleatorio; el mismo que usa n8n
LEMONSQUEEZY_WEBHOOK_SECRET=      # el "signing secret" que definís al crear el webhook en Lemon Squeezy
LEMONSQUEEZY_CHECKOUT_URL=        # link de compra del plan: https://TU-TIENDA.lemonsqueezy.com/checkout/buy/ID-DEL-PLAN
PLAN_PRECIO=                      # texto que ve el barbero, ej: USD 15 por mes (variable de ejecución, no requiere reconstruir)
CONTACTO_EMAIL=                   # mail de contacto que ve el barbero si todavía no hay link de pago
TITULAR_LEGAL=                    # nombre y CUIT de quien opera el servicio (sale en privacidad y términos)
PRUEBA_DIAS=30                    # solo para el texto de la página de inicio; los días reales se definen en /admin
RESEND_API_KEY=
MAIL_FROM="Reservas <reservas@tudominio.com>"   # dominio verificado en Resend
