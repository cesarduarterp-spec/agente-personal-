# ---------- Dominio / SSL ----------
DOMAIN=midominio.com                 # se publican n8n.midominio.com, ntfy.midominio.com, app.midominio.com
ACME_EMAIL=yo@midominio.com

# ---------- n8n ----------
N8N_VERSION=2.43.6
N8N_DB_PASSWORD=cambiar-por-un-password-largo
N8N_ENCRYPTION_KEY=generar-con-openssl-rand-hex-32

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=123456789:AA...             # de @BotFather
TELEGRAM_BOT_USERNAME=MiAsistenteBot           # sin @ (lo usa el botón "Hablar" de la PWA)
TELEGRAM_WEBHOOK_SECRET=generar-con-openssl-rand-hex-24
TELEGRAM_ALLOWED_CHAT_ID=123456789             # tu chat id (solo vos podés usar el bot)
USER_NAME=César                                # cómo te llama el asistente

# ---------- Gemini ----------
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash                  # escucha el audio .ogg directo (multimodal)

# ---------- Grok (respaldo si Gemini falla) ----------
XAI_API_KEY=xai-...                            # console.x.ai
GROK_MODEL=grok-4.3                            # transcribe el audio con /v1/stt y responde con las mismas tools

# ---------- Supabase ----------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...                       # pública (PWA)
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # SECRETA (solo n8n)
SUPABASE_DB_URL=postgresql://...               # Connect → Session pooler (solo lo usa el instalador)

# ---------- ntfy ----------
NTFY_TOPIC=agenda-alertas
NTFY_TOKEN=tk_...                              # docker compose exec ntfy ntfy token add <usuario>

# ---------- Email (Resend) ----------
RESEND_API_KEY=re_...
BRIEFING_EMAIL_FROM=Asistente <asistente@midominio.com>
BRIEFING_EMAIL_TO=yo@midominio.com

# ---------- Clima (Open-Meteo, sin API key) ----------
WEATHER_LAT=-33.30
WEATHER_LON=-66.34
WEATHER_CITY=San Luis

# ---------- Google Calendar sync ----------
GCAL_SYNC_SECRET=generar-con-openssl-rand-hex-24   # header del Database Webhook de Supabase
